#!/bin/sh

RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m'

echo "--- " + $BLUE + "commit-msg" + $NC + " hook ---"

commit_msg=$(cat "$1")
pattern="^(feat|fix|docs|style|refactor|test|chore|perf|ci|build|revert)(\(.+\))?:\s.+"

if ! echo "$commit_msg" | grep -qE "$pattern"; then
  echo ""
  echo "Commit message must follow Git Conventional Commits specification:"
  echo "  type(scope): description"
  echo ""
  echo "Types: feat, fix, docs, style, refactor, test, chore, perf, ci, build, revert"
  echo ""
  echo "Examples:"
  echo "  feat(auth): add JWT refresh token rotation"
  echo "  fix(intercontrats): resolve pagination offset bug"
  echo "  docs(readme): update installation instructions"
  echo ""
  echo "--- " + $BLUE + "commit-msg" + $NC + " hook completed " + $RED "failed" + $NC "---"
  exit 1
fi

echo "--- " + $BLUE + "commit-msg" + $NC + " hook completed " + $GREEN "successfully" + $NC "---"
