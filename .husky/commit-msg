#!/bin/sh

RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m'

printf -- "--- %bcommit-msg%b hook ---\n" "$BLUE" "$NC"

commit_msg=$(cat "$1")
pattern="^(feat|fix|docs|style|refactor|test|chore|perf|ci|build|revert)(\(.+\))?:\s.+"

if ! echo "$commit_msg" | grep -qE "$pattern"; then
  printf "\nCommit message must follow Git Conventional Commits specification:\n"
  printf "  type(scope): description\n\n"
  printf "Types: feat, fix, docs, style, refactor, test, chore, perf, ci, build, revert\n\n"
  printf "Examples:\n"
  printf "  feat(auth): add JWT refresh token rotation\n"
  printf "  fix(intercontrats): resolve pagination offset bug\n"
  printf "  docs(readme): update installation instructions\n\n"
  printf -- "--- %bcommit-msg%b hook completed %bfailed%b ---\n" "$BLUE" "$NC" "$RED" "$NC"
  exit 1
fi

printf "Commit message \"%b\" is valid.\n" "$commit_msg"
printf -- "--- %bcommit-msg%b hook completed %bsuccessfully%b ---\n" "$BLUE" "$NC" "$GREEN" "$NC"
