# EditorConfig - Universal Editor Configuration
# https://editorconfig.org

root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# JSON files
[*.json]
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_size = 2

# Python files
[*.py]
indent_size = 4

# Makefiles (require tabs)
[Makefile]
indent_style = tab

# Bash scripts
[*.sh]
indent_size = 2

# Shell scripts
[*.bash]
indent_size = 2

# Go files
[*.go]
indent_style = tab

# Rust files
[*.rs]
indent_size = 4

# Java files
[*.java]
indent_size = 4

# PHP files
[*.php]
indent_size = 4